# Copia este archivo a .env.local (local) y configura las mismas variables en Vercel.

# Aiven for PostgreSQL: "Service URI" del servicio (pestaña Overview).
DATABASE_URL=postgres://avnadmin:CONTRASENA@HOST.aivencloud.com:PUERTO/defaultdb?sslmode=require

# Certificado CA de Aiven (Overview > CA certificate). Pega todo el PEM; los saltos de linea pueden ir como \n.
# Recomendado: con el CA la conexion se verifica por completo.
DATABASE_CA=

# Secreto para firmar la sesion del panel (minimo 32 caracteres aleatorios).
# Generar:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Secreto del cron de cierre semanal (minimo 16 caracteres). Vercel lo envia como Bearer automaticamente.
CRON_SECRET=
